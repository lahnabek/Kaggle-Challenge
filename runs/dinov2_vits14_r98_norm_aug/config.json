{
  "run_name": "dinov2_vits14_r98_norm_aug",
  "seeds": [
    0
  ],
  "processing": {
    "resize_hw": [
      98,
      98
    ],
    "cast_float32": true,
    "imagenet_normalize": true,
    "extra_transform": {
      "transforms": [
        {
          "n": 3,
          "m": 5.0,
          "p": 1.0,
          "ops": [
            "TranslateX",
            "TranslateY",
            "ShearX",
            "ShearY",
            "Brightness",
            "Sharpness",
            "Color",
            "Contrast",
            "Rotate",
            "Equalize",
            "Identity",
            "Hsv",
            "Hed"
          ]
        }
      ],
      "allows_embedding_precompute": false
    },
    "sklearn_transformer": null,
    "augmentation": {
      "include_original": true,
      "k_aug_views": 0
    }
  },
  "model": {
    "backbone_name": "dinov2_vits14",
    "use_fp16": true,
    "adapter": {
      "enabled": false,
      "module_cls": null,
      "module_kwargs": null
    },
    "head": {
      "enabled": true,
      "module_cls": "DefaultBinaryHead",
      "module_kwargs": {}
    }
  },
  "train": {
    "batch_size": 16,
    "lr": 0.001,
    "weight_decay": 0.0,
    "num_epochs": 100,
    "early_stopping": {
      "monitor": "val_loss",
      "mode": "min",
      "patience": 10,
      "min_delta": 0.0
    },
    "use_center_balanced_batches": false,
    "center_proportions": null,
    "center_sampling": "empirical",
    "num_workers": 2,
    "drop_last": true
  },
  "do_predict_test": false,
  "predict_threshold": 0.5,
  "outlier_params": null,
  "outlier_scan_workers": 4,
  "outlier_scan_batch_size": 256,
  "data_fraction": null
}