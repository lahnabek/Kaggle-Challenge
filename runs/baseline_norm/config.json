{
  "run_name": "baseline_norm",
  "seeds": [
    0
  ],
  "processing": {
    "resize_hw": [
      98,
      98
    ],
    "cast_float32": true,
    "imagenet_normalize": true,
    "extra_transform": null,
    "sklearn_transformer": null
  },
  "model": {
    "backbone_name": "dinov2_vits14",
